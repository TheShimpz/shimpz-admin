{
  "name": "shimpz-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "scenarios": "vite dev --mode scenarios",
    "build": "vite build",
    "preview": "vite preview",
    "measure:assistants": "pnpm build && node perf/assistant-catalog.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "node tests/run-tests.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@shimpz/frontend": "https://codeload.github.com/TheShimpz/shimpz-frontend/tar.gz/4e2be156c874df0a2c8f11d60c819a5510dfc3ca",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "26.6.4",
    "acorn": "8.18.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.3",
    "vite": "8.1.5"
  }
}
