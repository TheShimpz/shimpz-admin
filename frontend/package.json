{
  "name": "shimpz-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "scenarios": "vite dev --mode scenarios",
    "build": "vite build",
    "preview": "vite preview",
    "measure:assistants": "pnpm build && node perf/assistant-catalog.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --fail-on-warnings",
    "test": "node tests/run-tests.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@shimpz/frontend": "https://codeload.github.com/TheShimpz/shimpz-frontend/tar.gz/dab6070dcf2735b13adbb18ab3ac2ad5b7d7a3aa",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "acorn": "8.18.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
